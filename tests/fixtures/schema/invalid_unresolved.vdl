// Negative fixture: a composed reference points at an ID that does not exist.

schema "runbooks" {
    type "Runbook" {
        field "label" text heading
        field "chapters" ref "Chapter" compose
    }

    type "Chapter" {
        field "label" text heading
        field "content" body
    }
}

entity "Chapter" "intro" {
    field "label" "Introduction"
    field "content" """Prose."""
}

entity "Runbook" "core-guide" {
    field "label" "Core Guide"
    field "chapters" [ "missing" ]
}
